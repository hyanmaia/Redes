#!/bin/bash

echo "Configurando OSPF no Roteador 1..."
docker exec -i clab-ga-roteamento-r1 vtysh << 'EOF'
configure terminal
router ospf
 ospf router-id 1.1.1.1
 network 10.0.0.0/8 area 0
 network 192.168.1.0/24 area 0
end
write memory
EOF

echo "Configurando OSPF no Roteador 2..."
