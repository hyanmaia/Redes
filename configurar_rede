docker exec clab-ga-roteamento-pc4 sh -c 'ip addr add 192.168.4.10/24 dev eth1; ip route add default via 192.168.4.1' 2>/dev/null
docker exec clab-ga-roteamento-pc5 sh -c 'ip addr add 192.168.5.10/24 dev eth1; ip route add default via 192.168.5.1' 2>/dev/null
echo "Rede e RIP configurados com sucesso!"
